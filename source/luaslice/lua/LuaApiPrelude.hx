      "timer.every = function(delay,callback) __ensureTimerHook(); local tag=__newTimerTag('__every_'); _G.__luaTimerCallbacks=_G.__luaTimerCallbacks or {}; _G.__luaTimerCallbacks[tag]=callback; if not invoke('runTimer',tag,delay,0) then _G.__luaTimerCallbacks[tag]=nil; return nil end; return tag end",
      "song = song or {}",
      "song.getPosition = function() return invoke('getSongPosition') end",
      "local function __ensureBeatHook() if _G.__luaBeatHookReady then return end; _G.__luaBeatHookReady=true; local old=onBeatHit; _G.onBeatHit=function(beat) if old then old(beat) end; local b=beat or curBeat; local callbacks=_G.__luaBeatCallbacks and _G.__luaBeatCallbacks[b]; if callbacks then for _,cb in ipairs(callbacks) do cb(b) end end end end",
      "local function __ensureStepHook() if _G.__luaStepHookReady then return end; _G.__luaStepHookReady=true; local old=onStepHit; _G.onStepHit=function(step) if old then old(step) end; local s=step or curStep; local callbacks=_G.__luaStepCallbacks and _G.__luaStepCallbacks[s]; if callbacks then for _,cb in ipairs(callbacks) do cb(s) end end end end",
