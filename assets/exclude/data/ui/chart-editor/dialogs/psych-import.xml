<?xml version="1.0" encoding="utf-8"?>
<dialog id="psychImportDialog" width="720" height="500" title="Import Psych Engine Chart">
  <vbox width="100%" height="100%" style="spacing:8px;">
    <label id="stepTitle" width="100%" style="font-size: 24px" text="Chart Difficulties" />
    <label id="stepDescription" width="100%" text="Choose the difficulties to import. Separate custom names with commas." />
    <vbox id="difficultyPanel" width="100%" style="spacing:6px;">
      <textfield id="difficultyInput" width="100%" text="easy, normal, hard" />
    </vbox>
    <scrollview id="uploadScroll" width="100%" height="100%" horizontalScrollPolicy="auto" verticalScrollPolicy="auto" contentWidth="100%" contentHeight="100%">
      <hbox id="uploadContainer" width="100%" height="100%" style="spacing:8px;" />
    </scrollview>
    <label id="statusLabel" width="100%" text="" />
    <hbox width="100%">
      <button id="dialogCancel" text="Cancel" />
      <spacer width="100%" />
      <button id="dialogAdd" text="Add Chart" />
      <button id="dialogSkip" text="Skip" />
      <button id="dialogContinue" text="Continue" />
    </hbox>
  </vbox>
</dialog>
