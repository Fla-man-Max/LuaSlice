<?xml version="1.0" encoding="utf-8"?>
<dialog width="560" title="Stage Format Converter">
  <vbox width="100%" style="spacing: 12px;">
    <label width="100%" text="Convert stage data between supported engines without replacing the stage currently open in the editor." />
    <hbox width="100%">
      <dropdown id="fromEngine" width="44%" selectedIndex="0">
        <data>
          <item id="base" text="Base Game" />
          <item id="psych" text="Psych Engine (v1.0.4)" />
          <item id="codename" text="Codename Engine" />
        </data>
      </dropdown>
      <spacer width="3%" />
      <label id="conversionArrow" width="6%" text="&#8594;" horizontalAlign="center" verticalAlign="center" style="font-size: 28px; color: #4EA5FF;" />
      <spacer width="3%" />
      <dropdown id="toEngine" width="44%" selectedIndex="1">
        <data>
          <item id="base" text="Base Game" />
          <item id="psych" text="Psych Engine (v1.0.4)" />
          <item id="codename" text="Codename Engine" />
        </data>
      </dropdown>
    </hbox>
    <label id="conversionDescription" width="100%" horizontalAlign="center" />
    <label width="100%" text="The converter handles stage layout data. Keep or copy the matching image and animation assets into the target engine." style="color: #A0A0A0;" />
    <label id="conversionStatus" width="100%" text="" />
  </vbox>
</dialog>
